{
  "name": "kube-cluster-ui",
  "productName": "Kube Cluster UI",
  "version": "2.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/contd/kube-cluster-ui.git"
  },
  "description": "A Kubernetes cluster browser inspired by LENS.",
  "main": ".vite/build/main.js",
  "private": true,
  "keywords": [
    "electron",
    "kubernetes",
    "lens",
    "cluster",
    "ui"
  ],
  "author": {
    "name": "Jason Kumpf",
    "email": "jason.kumpf@apexsupplychain.com"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:builder": "electron-forge package && electron-builder --config electron-builder.yml --publish never",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test:e2e": "playwright test && npm run generate:video-preview",
    "test:unit": "vitest run",
    "test": "vitest run && npm run test:e2e",
    "generate:video-preview": "node scripts/generate-video-preview.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.63.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.4",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@pengx17/electron-forge-maker-appimage": "^1.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide": "^1.45.0",
    "update-electron-app": "^3.3.0",
    "yaml": "^2.9.1"
  }
}
